{
  "name": "personal-site-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint --deny-warnings && stylelint \"src/**/*.css\"",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "types:generate": "openapi-typescript ../backend/openapi.json -o src/api/schema.d.ts",
    "types:check": "npm run types:generate && git diff --exit-code -- src/api/schema.d.ts",
    "e2e": "playwright test",
    "e2e:update": "playwright test --update-snapshots",
    "e2e:report": "playwright show-report",
    "preview": "vite preview"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "dependencies": {
    "@fontsource/chivo": "^5.3.0",
    "@fontsource/martian-mono": "^5.3.0",
    "@fontsource/space-mono": "^5.3.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "react-router": "^7.18.4"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.63.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^4.1.11",
    "jsdom": "^30.1.0",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.8",
    "stylelint": "^17.15.0",
    "stylelint-config-recommended": "^18.0.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0",
    "vitest": "^4.1.11"
  }
}
