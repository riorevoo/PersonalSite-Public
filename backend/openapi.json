{
  "components": {
    "schemas": {
      "ChatRequest": {
        "properties": {
          "history": {
            "description": "Earlier turns in this conversation, oldest first.",
            "items": {
              "$ref": "#/components/schemas/ChatTurn"
            },
            "maxItems": 20,
            "title": "History",
            "type": "array"
          },
          "message": {
            "description": "The visitor's question.",
            "minLength": 1,
            "title": "Message",
            "type": "string"
          }
        },
        "required": [
          "message"
        ],
        "title": "ChatRequest",
        "type": "object"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "title": "Answer",
            "type": "string"
          }
        },
        "required": [
          "answer"
        ],
        "title": "ChatResponse",
        "type": "object"
      },
      "ChatTurn": {
        "properties": {
          "content": {
            "maxLength": 4000,
            "title": "Content",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "assistant"
            ],
            "title": "Role",
            "type": "string"
          }
        },
        "required": [
          "role",
          "content"
        ],
        "title": "ChatTurn",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "The shape of an error returned by the API (FastAPI's default `detail` key).",
        "properties": {
          "detail": {
            "title": "Detail",
            "type": "string"
          }
        },
        "required": [
          "detail"
        ],
        "title": "ErrorResponse",
        "type": "object"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "title": "Detail",
            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "HealthResponse",
        "type": "object"
      },
      "PostDetail": {
        "properties": {
          "body": {
            "description": "The post as Markdown.",
            "title": "Body",
            "type": "string"
          },
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "dek": {
            "description": "One-sentence summary shown under the title.",
            "title": "Dek",
            "type": "string"
          },
          "draft": {
            "description": "True only for a draft shown because APP_SHOW_DRAFTS is on.",
            "title": "Draft",
            "type": "boolean"
          },
          "read_minutes": {
            "description": "Estimated reading time in minutes.",
            "minimum": 1.0,
            "title": "Read Minutes",
            "type": "integer"
          },
          "slug": {
            "description": "The URL part: /writing/<slug>.",
            "title": "Slug",
            "type": "string"
          },
          "tag": {
            "title": "Tag",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title",
          "dek",
          "tag",
          "date",
          "read_minutes",
          "draft",
          "body"
        ],
        "title": "PostDetail",
        "type": "object"
      },
      "PostSummary": {
        "properties": {
          "date": {
            "format": "date",
            "title": "Date",
            "type": "string"
          },
          "dek": {
            "description": "One-sentence summary shown under the title.",
            "title": "Dek",
            "type": "string"
          },
          "draft": {
            "description": "True only for a draft shown because APP_SHOW_DRAFTS is on.",
            "title": "Draft",
            "type": "boolean"
          },
          "read_minutes": {
            "description": "Estimated reading time in minutes.",
            "minimum": 1.0,
            "title": "Read Minutes",
            "type": "integer"
          },
          "slug": {
            "description": "The URL part: /writing/<slug>.",
            "title": "Slug",
            "type": "string"
          },
          "tag": {
            "title": "Tag",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          }
        },
        "required": [
          "slug",
          "title",
          "dek",
          "tag",
          "date",
          "read_minutes",
          "draft"
        ],
        "title": "PostSummary",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Personal Site API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/chat": {
      "post": {
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "413": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Request body is too large."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Too many questions from this address."
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "The answering engine is unavailable."
          }
        },
        "summary": "Chat",
        "tags": [
          "chat"
        ]
      }
    },
    "/api/health": {
      "get": {
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "Health",
        "tags": [
          "health"
        ]
      }
    },
    "/api/posts": {
      "get": {
        "description": "Published posts, newest first.",
        "operationId": "list_posts_api_posts_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/PostSummary"
                  },
                  "title": "Response List Posts Api Posts Get",
                  "type": "array"
                }
              }
            },
            "description": "Successful Response"
          }
        },
        "summary": "List Posts",
        "tags": [
          "posts"
        ]
      }
    },
    "/api/posts/{slug}": {
      "get": {
        "operationId": "get_post_api_posts__slug__get",
        "parameters": [
          {
            "in": "path",
            "name": "slug",
            "required": true,
            "schema": {
              "title": "Slug",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PostDetail"
                }
              }
            },
            "description": "Successful Response"
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "There is no post with this slug."
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            },
            "description": "Validation Error"
          }
        },
        "summary": "Get Post",
        "tags": [
          "posts"
        ]
      }
    },
    "/api/resume": {
      "get": {
        "description": "The newest resume PDF, shown inline so the site's resume link can open it in a new tab.",
        "operationId": "get_resume_api_resume_get",
        "responses": {
          "200": {
            "content": {
              "application/pdf": {}
            },
            "description": "The newest resume, as a PDF."
          },
          "404": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "There is no resume PDF yet."
          }
        },
        "summary": "Get Resume",
        "tags": [
          "resume"
        ]
      }
    }
  }
}
