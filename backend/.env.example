# Copy to .env and adjust. All settings use the APP_ prefix (see app/core/config.py).
APP_ENV=development
# APP_LOG_LEVEL=INFO
# JSON list of allowed browser origins (the Vite dev server by default). In production this must
# be the real site origin(s); a wildcard or localhost makes the app refuse to start.
APP_CORS_ORIGINS=["http://localhost:5173"]
# Per-visitor limits on POST /api/chat.
# APP_RATE_LIMIT_PER_MINUTE=10
# APP_RATE_LIMIT_PER_DAY=100
# Number of reverse proxies in front of the app (Render: 1). Leave 0 when reached directly.
# APP_TRUSTED_PROXY_HOPS=0
# APP_MAX_BODY_BYTES=262144
# Answering engine (see app/services/answerer.py): "stub" (placeholder answers) or "llm" (Claude).
APP_ANSWERER=stub
# The name the assistant uses for the site owner.
# APP_OWNER_NAME=Your Name

# --- LLM engine (APP_ANSWERER=llm). The key goes here or in a secret manager, never in git. ---
# APP_LLM_API_KEY=
# APP_LLM_MODEL=claude-haiku-4-5-20251001
# Cap on the length of one answer, the provider timeout, and how many earlier turns are sent.
# APP_LLM_MAX_TOKENS=500
# APP_LLM_TIMEOUT_SECONDS=15
# APP_LLM_HISTORY_TURNS=6
# Price per million tokens, used to estimate spend from the token counts the API reports.
# APP_LLM_INPUT_USD_PER_MTOK=1.0
# APP_LLM_OUTPUT_USD_PER_MTOK=5.0
# Spend ceilings (UTC calendar month and day). At a ceiling the assistant shows the cap message
# instead of calling the model; exact FAQ matches still answer.
# APP_MONTHLY_BUDGET_USD=1.5
# APP_DAILY_BUDGET_USD=0.3
# Where spend is counted: "memory" (resets on restart; development) or "firestore" (production;
# uses the default Google credentials of the environment it runs in).
# APP_USAGE_STORE=memory
# APP_USAGE_COLLECTION=usage
# Folder of Markdown knowledge files. Defaults to backend/knowledge; set it to keep content private.
# APP_KNOWLEDGE_DIR=
